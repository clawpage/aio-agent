{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Private single-owner personal agent: Codex + AIO Sandbox control plane with Chinese UI",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node tests/e2e/live-smoke.mjs",
    "test:ui": "playwright test",
    "test:ui:login": "PA_E2E_BASE=http://localhost:4891 PA_E2E_STATE=var/.auth/state-local.json playwright test tests/e2e/login.spec.ts"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "express": "5.2.1",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
