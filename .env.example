# AIO Agent 运行参数（真实覆盖请写 var/runtime.env，该文件被 git 忽略）
PA_BIND=127.0.0.1
PA_PORT=4891
# 运行数据目录；默认即本仓库下的 var/，无需设置。需要改时取消注释并改成你的路径：
# PA_DATA_DIR=/absolute/path/to/repo/var
# 公网入口：以下 agent.example.com / workspace.example.com 只是占位示例，**必须替换**
# 为你自己的两个精确域名（没有公共 demo）。本地开发不设置这两个也可用 loopback 访问。
PA_PRIMARY_HOST=agent.example.com
PA_WORKSPACE_HOST=workspace.example.com
# 仅当请求确实经由你自己可信的反向代理（会覆盖 CF-Connecting-IP）时才设为 1；
# 默认 0，避免限速被伪造头绕过。
PA_TRUST_CF_CONNECTING_IP=0
# 固定镜像与容器；升级需人工确认
PA_SANDBOX_IMAGE=ghcr.io/agent-infra/sandbox:1.11.0
PA_SANDBOX_CONTAINER=personal-agent-sandbox
PA_SANDBOX_PORT=18081
PA_SANDBOX_AUTOSTART=1
# 沙箱内固定版 Codex CLI：装在持久卷 personal-agent-codex 里，不改固定镜像。
# 升级前先用独立 CODEX_HOME 验证 model/list 与一次真实 turn（见运行手册）。
PA_SANDBOX_CODEX_VERSION=0.156.1
# 安装前缀与二进制路径默认由版本号推导；仅在特殊情况下才需要覆写
# PA_SANDBOX_CODEX_PREFIX=/home/gem/.codex/tools/codex-0.156.1
# PA_SANDBOX_CODEX_BIN=/home/gem/.codex/tools/codex-0.156.1/node_modules/.bin/codex
# 默认模型：新会话与旧会话后续轮次都用它，网页选择器默认显示它
PA_DEFAULT_MODEL=gpt-6-sol
# 自动标题：首轮完成后用隔离的临时线程给会话命名；1 开启，0 关闭
PA_AUTO_TITLE=1
# 只用于自动标题的模型与思考级别：独立于主对话模型
PA_TITLE_MODEL=gpt-6-luna
PA_TITLE_EFFORT=low
# 标题最大字符数与单次标题运行超时（秒）
PA_TITLE_MAX_CHARS=24
PA_TITLE_TIMEOUT_SECONDS=30
# 主 Codex 轮次并发上限（跨会话；同一会话始终串行）。取值 clamp 到 1–3，默认 3
PA_MAX_CONCURRENT_TURNS=3
# 主轮次请求的思考摘要模式：concise / auto / detailed / none（不走原始思维链）
PA_REASONING_SUMMARY=concise
# 仅在需要手工指定密码时设置；否则首次启动生成 0600 本地文件
# PA_OWNER_PASSWORD=
# 显式轮换 owner 密码（会重写 var/owner-secret.txt）
# PA_OWNER_PASSWORD_RESET=1

# ------------------------------------------------- OpenCode Go 桥模型（可选）
# 让统一配置页的模型选择器多出几个走本机 LiteLLM Responses 桥的模型。
# 前置条件：宿主机已装并运行 tools/codex-opencode-go（监听 127.0.0.1:4017），
# 密钥文件存在且权限为 600/400。默认 auto：仅在能取到密钥时才出现该模型。
# 沙箱经 host.docker.internal 访问宿主桥；该模型仅支持文本输入。
# 密钥只从环境变量或该私有文件读取，绝不写入仓库、日志、数据库、argv 或前端。
PA_OPENCODE_GO_ENABLED=auto
# 容器内可达的桥地址（沙箱 → 宿主）
PA_OPENCODE_GO_BASE_URL=http://host.docker.internal:4017/v1
# 桥提供的模型 id，逗号分隔。deepseek 支持 low/high/max；mimo 上游拒绝 max，
# 只提供 low/high（两个模型都只支持文本输入）。
# PA_OPENCODE_GO_MODELS=deepseek-v4.1-flash,mimo-v2.6-pro
# 兼容旧变量：设置它等价于只列出这一个模型（优先级高于 PA_OPENCODE_GO_MODELS）。
# PA_OPENCODE_GO_MODEL=deepseek-v4.1-flash
# 注入 Codex 的 provider id（与 ~/.codex/opencode-go.config.toml 保持一致）
PA_OPENCODE_GO_PROVIDER_ID=opencode_go
# 密钥文件（逐行 KEY=VALUE；宽于 600/400 会被拒绝并给出可读日志）
# PA_OPENCODE_GO_SECRETS_FILE=~/.config/codex-opencode-go/secrets.env
# 密钥所在的环境变量名（沙箱内 Codex 读它；可以在宿主进程环境里直接提供）
# PA_OPENCODE_GO_ENV_KEY=LITELLM_MASTER_KEY

# ---------------------------------------------------------------- 文档工具
# 沙箱内文档预览/转换（Word/Excel/PPT/PDF → 分页图片预览、格式转换）。
# 工具装在持久卷里的隔离目录，不改固定镜像；未就绪时界面会如实降级。
PA_DOCUMENTS_ENABLED=1
# 工具目录（默认由 Codex 前缀推导，通常在持久卷内）；一般无需修改
# PA_DOC_TOOLS_DIR=/home/gem/.codex/tools/aio-doc
# 单次预览最多生成多少页（后续页显示为截断）
PA_DOC_PREVIEW_MAX_PAGES=12
# 单次转换/渲染的容器内超时（秒）
PA_DOC_TIMEOUT_SECONDS=120
# 渲染缓存上限（MB）与并发转换上限
PA_DOC_CACHE_MAX_MB=64
PA_DOC_MAX_CONCURRENT=2
# 就绪检查结果的复用时间（秒）
PA_DOC_READINESS_TTL_SECONDS=60
# 内联文本预览的大小上限（KB）
PA_DOC_TEXT_MAX_KB=256

# ------------------------------------------------- 浏览器内存生命周期（仅 Chromium）
# 无人使用沙箱浏览器时真正释放其进程内存，下次需要时从快照重建。
# 只释放浏览器：容器、Codex、终端、code-server、Jupyter 都不受影响。
PA_BROWSER_LIFECYCLE=1
# 无任务/观看/进行中请求时，空闲多久后释放（秒；下限 30）
PA_BROWSER_IDLE_SECONDS=300
# 面板心跳租约有效期（秒；下限 10）；停止心跳即到期释放
PA_BROWSER_VIEWER_TTL_SECONDS=60
# 有未提交输入时：block=保守拒绝释放并说明原因，warn=释放并如实告警
PA_BROWSER_DIRTY_INPUT_POLICY=block
# 受管 helper 与快照所在目录（持久卷内，一般无需修改）
# PA_BROWSER_TOOL_DIR=/home/gem/.codex/tools/aio-browser
# 单次 helper 调用、等待 CDP、停止的超时（秒）
# PA_BROWSER_HELPER_TIMEOUT_SECONDS=45
# PA_BROWSER_WAKE_TIMEOUT_SECONDS=90
# PA_BROWSER_STOP_TIMEOUT_SECONDS=30
