# personal-agent 运行参数（真实覆盖请写 var/runtime.env，该文件被 git 忽略）
PA_BIND=127.0.0.1
PA_PORT=4891
PA_DATA_DIR=/Users/mengxiao/workspace/projects/personal-agent/var
PA_PRIMARY_HOST=agent.zymx.tech
PA_WORKSPACE_HOST=agent-workspace.zymx.tech
# 由专用 Cloudflare tunnel 转发时开启（外部无法伪造该头）
PA_TRUST_CF_CONNECTING_IP=1
# 固定镜像与容器；升级需人工确认
PA_SANDBOX_IMAGE=ghcr.io/agent-infra/sandbox:1.11.0
PA_SANDBOX_CONTAINER=personal-agent-sandbox
PA_SANDBOX_PORT=18081
PA_SANDBOX_AUTOSTART=1
# 仅在需要手工指定密码时设置；否则首次启动生成 0600 本地文件
# PA_OWNER_PASSWORD=
# 显式轮换 owner 密码（会重写 var/owner-secret.txt）
# PA_OWNER_PASSWORD_RESET=1
