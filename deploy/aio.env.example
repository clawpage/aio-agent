# Settings for deploy/aio.mjs and the compose files (copy to deploy/aio.env, or
# point AIO_ENV_FILE at your own file). Paths may be absolute or relative to the repository.

# Which layers run on this machine: any of ui,control,sandbox.
AIO_LAYERS=ui,control,sandbox
# Compose project name; also names the shared network (<project>-net).
AIO_PROJECT=aio
# Image version for all layers (default: package.json version); override one layer
# with AIO_UI_VERSION / AIO_CONTROL_VERSION / AIO_SANDBOX_VERSION.
#AIO_VERSION=0.2.0
# Registry prefix when images are pushed and pulled across machines, e.g. ghcr.io/you/
#AIO_IMAGE_PREFIX=

# Where each layer listens on this machine.
AIO_UI_PUBLISH=127.0.0.1:4891
AIO_CONTROL_PUBLISH=127.0.0.1:4892
# The port sandboxes use to reach the control plane's gateway (host.docker.internal:<port>).
AIO_GATEWAY_PORT=4902

# The node token shared by the control plane and every sandbox node (deploy/aio.mjs init).
AIO_SECRET_NODE_TOKEN=var/deploy/node-token.env
# Optional credentials (private KEY=value files, mode 600); leave unset to turn a feature off.
#AIO_SECRET_CLAUDE_CODE=/path/to/claude-code.env      # CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY
#AIO_SECRET_JEV=/path/to/jev.env                       # TYPESAFE_API_KEY
#AIO_SECRET_KB_MCP=/path/to/mcp.env                    # KB_MCP_TOKEN
#AIO_SECRET_HA_MCP=/path/to/ha-mcp.env                 # HA_MCP_TOKEN (Home Assistant long-lived token)
#AIO_SECRET_PHONE_BRIDGE=/path/to/phone-bridge.env     # PHONE_BRIDGE_TOKEN (bin/phone-bridge.mjs setup writes it)
#AIO_SECRET_KEYBOARD_BRIDGE=/path/to/keyboard-bridge.env  # KEYBOARD_BRIDGE_TOKEN (bin/keyboard-bridge.mjs setup writes it)

# ChatGPT models for the owner: run `node deploy/aio.mjs codex-login` once, then set this to on.
#AIO_HOST_CODEX=on
# Control plane settings (PA_* variables, see .env.example): hosts, knowledge base URL, ...
AIO_CONTROL_ENV_FILE=control.env
# The data volume (databases, owner secret, push keys, shares).
AIO_CONTROL_DATA=aio-control-data
# Moving an existing host deployment: `run` seeds an empty data volume from this directory once.
#AIO_SEED_DATA_FROM=var
# The control plane's local time zone (prompt timestamps, "today"); match PA_BROWSER_TIMEZONE.
#AIO_TZ=America/Los_Angeles
# The workspace origin the console may frame (the UI edge's CSP).
AIO_WORKSPACE_ORIGIN=https://workspace.example.com

# Sandbox nodes the control plane drives (name=url, comma-separated; the first holds existing accounts).
#AIO_SANDBOX_NODES=local=http://sandbox:4894,big=http://10.0.0.12:4894
# How sandboxd reaches the ports sandboxes publish: host.docker.internal on Docker Desktop.
#AIO_SANDBOXD_CONTAINER_HOST=host.docker.internal
