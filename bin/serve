#!/usr/bin/env node
/**
 * Production supervisor for personal-agent.
 *
 * Runs the three layers and the dedicated Cloudflare tunnel, restarting any
 * child that exits (with backoff) and forwarding SIGTERM/SIGINT so
 * `tools/start.sh stop personal-agent` shuts everything down cleanly.
 *
 * PA_DEPLOY (var/runtime.env) picks how the layers run:
 *   compose  the three images under Docker Compose (deploy/aio.mjs, settings in
 *            var/deploy/aio.env); sandbox containers are not compose services and
 *            keep running across restarts
 *   host     (default) three Node processes on this machine: sandboxd on :4894,
 *            the control plane on :4892 and the UI edge on :4891
 *
 * Either way the tunnel sends the console host to :4891 and the workspace host to :4892.
 * Optional runtime overrides: var/runtime.env (KEY=VALUE per line).
 */
import { spawn } from "node:child_process";
import { randomBytes } from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import process from "node:process";

const ROOT = path.resolve(import.meta.dirname, "..");
const VAR = path.join(ROOT, "var");
const LOGS = path.join(VAR, "logs");
const CLOUDFLARED = process.env.PA_CLOUDFLARED_BIN ?? "/opt/homebrew/bin/cloudflared";
const TUNNEL_CONFIG = path.join(VAR, "cloudflared", "config.yml");
const NODE_TOKEN = path.join(VAR, "sandbox-node.env");

fs.mkdirSync(LOGS, { recursive: true });

function loadRuntimeEnv() {
  const file = path.join(VAR, "runtime.env");
  const env = { ...process.env };
  if (!fs.existsSync(file)) return env;
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const idx = trimmed.indexOf("=");
    if (idx <= 0) continue;
    env[trimmed.slice(0, idx).trim()] = trimmed.slice(idx + 1).trim();
  }
  return env;
}

const baseEnv = {
  PA_BIND: "127.0.0.1",
  PA_PORT: "4892",
  PA_UI_PORT: "4891",
  // Behind the dedicated tunnel the edge overwrites CF-Connecting-IP.
  PA_TRUST_CF_CONNECTING_IP: "1",
  ...loadRuntimeEnv(),
};
const mode = baseEnv.PA_DEPLOY === "compose" ? "compose" : "host";

function log(message) {
  const line = JSON.stringify({ ts: new Date().toISOString(), supervisor: "personal-agent", msg: message });
  process.stdout.write(line + "\n");
}

function openLog(name) {
  return fs.openSync(path.join(LOGS, `${name}.log`), "a");
}

const children = new Map();

const restartTimers = new Set();

function startChild(name, command, args, env, { required }) {
  // Never resurrect a child while (or after) the supervisor is shutting down.
  if (shuttingDown) return null;
  if (required && !fs.existsSync(command) && command.startsWith("/")) {
    log(`fatal: ${command} not found`);
    process.exit(1);
  }
  const out = openLog(name);
  let child;
  try {
    child = spawn(command, args, { cwd: ROOT, env, stdio: ["ignore", out, out] });
  } finally {
    // The child holds its own descriptor; the parent must not leak this one.
    fs.closeSync(out);
  }
  child.on("exit", (code, signal) => {
    children.delete(name);
    if (shuttingDown) return;
    log(`${name} exited code=${code} signal=${signal}; restarting in 3s`);
    const timer = setTimeout(() => {
      restartTimers.delete(timer);
      startChild(name, command, args, env, { required });
    }, 3000);
    restartTimers.add(timer);
  });
  child.on("error", (err) => log(`${name} spawn error: ${err.message}`));
  children.set(name, child);
  log(`${name} started pid=${child.pid}`);
  return child;
}

let shuttingDown = false;
function shutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;
  for (const timer of restartTimers) clearTimeout(timer);
  restartTimers.clear();
  log(`received ${signal}, stopping children`);
  for (const [name, child] of children) {
    log(`stopping ${name} pid=${child.pid}`);
    child.kill("SIGTERM");
  }
  setTimeout(() => {
    for (const [, child] of children) child.kill("SIGKILL");
    process.exit(0);
  }, 5000).unref();
}

process.on("SIGTERM", () => shutdown("SIGTERM"));
process.on("SIGINT", () => shutdown("SIGINT"));

/** Refuse to serve a stale build: a dist tree older than the newest source file. */
function newestMtime(dir) {
  let newest = 0;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) newest = Math.max(newest, newestMtime(full));
    else if (/\.(ts|tsx)$/.test(entry.name)) newest = Math.max(newest, fs.statSync(full).mtimeMs);
  }
  return newest;
}
function requireBuild(layer, entry) {
  if (!fs.existsSync(entry)) {
    log(`fatal: ${entry} missing; run npm run build first`);
    process.exit(1);
  }
  for (const src of [path.join(ROOT, "src", layer), path.join(ROOT, "src", "common")]) {
    if (fs.existsSync(src) && newestMtime(src) > fs.statSync(entry).mtimeMs) {
      log(`fatal: ${path.relative(ROOT, src)} is newer than ${path.relative(ROOT, entry)}; run npm run build before starting`);
      process.exit(1);
    }
  }
}

/** The shared secret between the control plane and sandboxd on this machine. */
function ensureNodeToken() {
  if (fs.existsSync(NODE_TOKEN)) return;
  fs.writeFileSync(NODE_TOKEN, `AIO_SANDBOX_NODE_TOKEN=${randomBytes(32).toString("hex")}\n`, { mode: 0o600, flag: "wx" });
  log("generated the sandbox node token");
}

if (mode === "compose") {
  // deploy/aio.mjs checks the images fit together, brings them up and stops them on SIGTERM.
  startChild("personal-agent", process.execPath, [path.join(ROOT, "deploy", "aio.mjs"), "run"], { ...baseEnv, AIO_ENV_FILE: baseEnv.AIO_ENV_FILE ?? path.join(VAR, "deploy", "aio.env") }, { required: true });
} else {
  const sandboxEntry = path.join(ROOT, "dist", "sandbox", "index.js");
  const controlEntry = path.join(ROOT, "dist", "control", "index.js");
  const uiEntry = path.join(ROOT, "src", "ui", "edge.mjs");
  requireBuild("sandbox", sandboxEntry);
  requireBuild("control", controlEntry);
  if (!fs.existsSync(path.join(ROOT, "dist", "ui", "index.html"))) {
    log("fatal: dist/ui missing; run npm run build first");
    process.exit(1);
  }
  ensureNodeToken();
  startChild("personal-agent-sandboxd", process.execPath, [sandboxEntry], { ...baseEnv, PA_SANDBOXD_TOKEN_FILE: NODE_TOKEN, PA_SANDBOXD_DATA_DIR: path.join(VAR, "sandboxd") }, { required: true });
  startChild("personal-agent", process.execPath, [controlEntry], baseEnv, { required: true });
  startChild("personal-agent-ui", process.execPath, [uiEntry], {
    ...baseEnv,
    AIO_UI_PORT: baseEnv.PA_UI_PORT,
    AIO_CONTROL_URL: `http://127.0.0.1:${baseEnv.PA_PORT}`,
    AIO_WORKSPACE_ORIGIN: `https://${baseEnv.PA_WORKSPACE_HOST ?? "agent-workspace.clawpage.ai"}`,
  }, { required: true });
}

if (fs.existsSync(TUNNEL_CONFIG)) {
  startChild("personal-agent-tunnel", CLOUDFLARED, ["--no-autoupdate", "--config", TUNNEL_CONFIG, "tunnel", "run"], baseEnv, {
    required: true,
  });
} else {
  log(`tunnel config ${TUNNEL_CONFIG} missing; running without the public tunnel`);
}

// Keep the supervisor alive (children have their own exit handlers).
setInterval(() => undefined, 60_000);
