{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIOAgent",
  "version": "0.1.2",
  "identifier": "ai.clawpage.agent",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
